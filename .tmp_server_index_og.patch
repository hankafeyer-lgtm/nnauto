+function buildListingPreviewMeta(listing: any, fallbackId: string) {
+  const rawPhotos =
+    listing?.photos ?? listing?.images ?? listing?.photoUrls ?? [];
+  const photos: string[] = Array.isArray(rawPhotos) ? rawPhotos : [];
+
+  const first = photos.find((p) => typeof p === "string" && p.trim() !== "");
+  let image = DEFAULT_OG_IMAGE;
+  if (first) {
+    const normalized = first.trim();
+    image = /^https?:\/\//i.test(normalized)
+      ? normalized
+      : `${BASE_URL}/objects/${normalizeKey(normalized)}`;
+  }
+
+  const priceNum = Number(listing?.price || 0);
+  const price = Number.isFinite(priceNum) ? priceNum.toLocaleString("cs-CZ") : "";
+  const brand = listing?.brand || "";
+  const model = listing?.model || "";
+  const year = listing?.year || "";
+
+  const title = `${year} ${brand} ${model} - ${price} Kč | ${SITE_NAME}`;
+  const descriptionRaw =
+    String(listing?.description || "").trim() ||
+    `Prodej ${year} ${brand} ${model}.`;
+  const description = descriptionRaw.slice(0, 180);
+  const id = listing?.id || fallbackId;
+  const url = `${BASE_URL}/listing/${id}`;
+
+  return { title, description, image, url };
+}
